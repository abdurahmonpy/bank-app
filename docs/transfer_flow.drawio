<mxfile host="app.diagrams.net" modified="2026-10-22T10:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="transfer-lifecycle" name="Transfer Lifecycle Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Client -->
        <mxCell id="client" value="Client / Mobile App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- Step 1: transfer.create -->
        <mxCell id="create_step" value="1. POST /rpc/&#xa;method: transfer.create&#xa;(ext_id, cards, amount, currency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- API Security & Validation -->
        <mxCell id="sec_val" value="2. Security &amp; Validation&#xa;- HMAC Signature check&#xa;- DRF Serializer&#xa;- Card status &amp; Balance check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="50" width="200" height="120" as="geometry" />
        </mxCell>
        
        <!-- Telegram OTP -->
        <mxCell id="otp_step" value="3. Generate 6-digit OTP&#xa;Send via Telegram Bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- State: Created -->
        <mxCell id="state_created" value="4. Return {state: 'created', otp_sent: true}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- Step 5: transfer.confirm -->
        <mxCell id="confirm_step" value="5. POST /rpc/&#xa;method: transfer.confirm&#xa;(ext_id, otp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="180" height="80" as="geometry" />
        </mxCell>
        
        <!-- Check OTP & Try Count -->
        <mxCell id="check_otp" value="6. OTP Match &amp;&#xa;Try Count &lt; 3?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="180" height="120" as="geometry" />
        </mxCell>
        
        <!-- Atomic DB Update -->
        <mxCell id="db_update" value="7. transaction.atomic()&#xa;- Debit Sender Card&#xa;- Credit Receiver Card&#xa;- state = 'confirmed'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="380" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Final Success Response -->
        <mxCell id="final_resp" value="8. Return {state: 'confirmed'}&#xa;Invalidate Card Caches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- Error Block -->
        <mxCell id="err_block" value="Wrong OTP&#xa;Increment try_count&#xa;Return Error 32712 / 32711" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" edge="1" source="client" target="create_step" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e2" edge="1" source="create_step" target="sec_val" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e3" edge="1" source="sec_val" target="otp_step" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e4" edge="1" source="otp_step" target="state_created" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e5" edge="1" source="state_created" target="client" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e6" edge="1" source="client" target="confirm_step" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e7" edge="1" source="confirm_step" target="check_otp" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e8" edge="1" source="check_otp" target="db_update" value="Yes" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e9" edge="1" source="check_otp" target="err_block" value="No" style="endArrow=classic;html=1;" parent="1" />
        <mxCell id="e10" edge="1" source="db_update" target="final_resp" style="endArrow=classic;html=1;" parent="1" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
